# VedoTom .gitignore
# Rule 1 of this repo: never commit device images, identifiers, keys, or raw logs.
# .githooks/pre-commit enforces the same rules at commit time ('aosp-academy setup' enables it).

# --- work/: the walkthrough's $Work folder --------------------------------------
# Downloads, venv, and everything the phone procedure creates, including
# work/private-backups (your phone's original images). Never committed.
work/
# dev/: the same folder on the Windows build machine (cache, tools, venv, build outputs).
dev/

# --- Device data: private, may hold calibration, keys, IMEI/serial ---------------
# (Also caught anywhere outside work/, in case something lands in the wrong place.)
*.img
*.bin
*.log
*.tar
*.csv
backups/
private-backups/
diagnostics/
private/
lk-analysis/
lk-patch-analysis/
magisk-patch-files/
unlock-keys.txt
*unlock-key*
captures/
screenshots/
*.mp4
*.mkv
# Traces can contain app names, package lists and log lines; proprietary blobs pulled from
# the device (vendor libraries, firmware, GSIs) must never be redistributed.
traces/
*.pftrace
*.perfetto-trace
blobs/
extracted/
*.so
*-gsi*.img
system*.img
vendor*.img

# --- Keys and secrets ----------------------------------------------------------
*.pem
*.key
*.pk8
*.p12
*.der
*.jks
*.keystore
keystore.properties
.env
.env.*
# adb: a machine's private key, and trusted-key lists built into images (work/adb_keys)
adbkey
adb_keys
wifi.json

# --- Third-party binaries and device inputs (downloaded and hash-pinned, never committed)
*.apk
*.aab
*.msi
platform-tools/
platform-tools.zip
testdpc-qrcode.png
val-protocol/
*.partial

# --- Workstation tools (aosp-academy setup) ---------------------------------------------
work/cache/
work/tools/
work/build/

# --- Python ----------------------------------------------------------------------
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/

# --- Documentation site (Zensical) ----------------------------------------------
site/
.cache/

# --- Java / Android builds -----------------------------------------------------
*.class
build-update/
build-cleanup/
release/
.gradle/
.kotlin/
local.properties
.externalNativeBuild/
.cxx/
*.iml
.idea/
**/app/build/
**/build/outputs/
# jadx / apktool output when inspecting apps
*-decompiled/
*-apktool/

# --- OS / editor clutter -------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*~
*.swp
