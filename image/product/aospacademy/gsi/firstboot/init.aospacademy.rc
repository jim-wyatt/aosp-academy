# aosp-academy first-boot service. Runs once per boot after sys.boot_completed, as root in the
# (userdebug-only, permissive) su domain, so it can call pm and write into app data folders.
# The script itself is idempotent; most boots it finds nothing to do and exits in a second.
service aospacademy_firstboot /product/bin/aospacademy-firstboot
    class late_start
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start aospacademy_firstboot

# 16 MiB log buffers (logd's default is 256 KiB, which the vendor's log spam rolls over in
# minutes). logd reads ro.logd.size / persist.logd.size at start only on automotive and desktop
# hardware types (system/logging/logd/LogSize.cpp), so a property alone does nothing on a phone;
# the size has to be set at runtime, as logcat -G does. logd sets logd.ready when it is up and
# clears it when it restarts, so this runs on every boot, early, and again after a logd restart.
service aospacademy_logsize /system/bin/logcat -b main,system,crash,events,radio,kernel -G 16M
    user root
    group root log
    seclabel u:r:su:s0
    oneshot
    disabled

on property:logd.ready=true
    start aospacademy_logsize

# Charge limit: the phone lives on its charger, and stock caps it at 80% (Moto Actions' battery
# protection). The chain on stock ends in Motorola's health HAL writing the limit to the vendor
# kernel module qpnp_adaptive_charge (upper_limit=80, lower_limit -1 = auto mode: charging is
# suspended above the limit and resumed below it). The image has that module and HAL but not the
# Moto client, so it makes the same write itself, from persist.aospacademy.charge_limit (product
# build.prop default 80; 100 = charge to full; see docs/environment/image.md). Re-applied whenever the property changes:
#   adb shell su 0 setprop persist.aospacademy.charge_limit 85
# WireGuard tunnel, when a deploy has left a config in /data/local/aospacademy-wg (aosp-academy
# deploy pushes it from the device node's work/wireguard/). Without one it exits at once.
service aospacademy_wireguard /product/bin/aospacademy-firstboot wireguard
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start aospacademy_wireguard

# Keeps the full tunnel's Wi-Fi bypass rules current when Wi-Fi drops and comes back (the
# script's wireguard-watch mode). Not oneshot: init restarts it if it ever exits.
service aospacademy_wgwatch /product/bin/aospacademy-firstboot wireguard-watch
    user root
    group root
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start aospacademy_wgwatch

service aospacademy_chargelimit /product/bin/aospacademy-firstboot charge-limit
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1 && property:persist.aospacademy.charge_limit=*
    start aospacademy_chargelimit
